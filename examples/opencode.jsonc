{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      // Replace with the absolute path to this plugin directory.
      "package": "/absolute/path/to/opencode-command-list",
      "options": {
        "recordPrompts": false,
        "notifyOnTurn": true,
        "autoShow": false
      }
    }
  ]
}
